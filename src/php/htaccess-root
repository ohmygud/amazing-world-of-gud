# THE AMAZING WORLD OF GUD — Apache settings (ignored safely if a module is missing)
DirectoryIndex index.html index.php
Options -Indexes

# private data of the CMS: never served
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_data(/|$) - [F,L]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType application/json .json
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # the content changes from the CMS: always revalidate it
  <FilesMatch "content\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf|png|gif|jpe?g|webp|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml font/ttf font/otf
</IfModule>
